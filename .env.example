# Supabase (requerido para el build y la app)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# R2 / API (subida de archivos)
# Frontend (Vite): opcionales; por defecto API en mismo origen y multimedia.koronel.cl
VITE_API_URL=
VITE_R2_PUBLIC_URL=https://multimedia.koronel.cl
VITE_WALINKA_APP_URL=https://go.ventalink.app

# Serverless API (Vercel Environment Variables): obligatorios para /api/upload/*
# R2_ACCOUNT_ID=tu-account-id
# R2_ACCESS_KEY_ID=tu-access-key
# R2_SECRET_ACCESS_KEY=tu-secret-key
# R2_BUCKET_NAME=multimedia-koronel
# R2_PUBLIC_URL=https://multimedia.koronel.cl
# (Supabase ya configurado: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY)

# Ciudad / sitio (opcionales; por defecto Coronel, Chile — ver src/config/city.js).
# Para desplegar el mismo motor en otra ciudad, solo hace falta cambiar estas
# variables (nombre, mapa, locale, moneda, prefijo telefónico), sin tocar código.
# VITE_SITE_NAME=CoronelLocal
# VITE_SITE_DOMAIN=coronellocal.cl
# VITE_SITE_DESCRIPTION=Directorio de negocios, clasificados, eventos, empleos y comunidad en Coronel y la región.
# VITE_CITY_NAME=Coronel
# VITE_CITY_REGION=Región del Biobío
# VITE_CITY_COUNTRY=Chile
# VITE_CITY_COUNTRY_CODE=CL
# VITE_CITY_LAT=-37.0298
# VITE_CITY_LNG=-73.1429
# VITE_PHONE_COUNTRY_CODE=56
# VITE_LOCALE=es-CL
# VITE_CURRENCY=CLP
# VITE_ADMIN_WHATSAPP=56993443682

# Opcionales (no necesarios para despliegue de prueba)
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
# VITE_GA_MEASUREMENT_ID=
# VITE_ADSENSE_ID=
# VITE_PERPLEXITY_API_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
